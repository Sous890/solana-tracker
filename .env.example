# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Solana JSON-RPC endpoint (HTTP)
RPC_HTTP_URL=https://your-rpc-provider.example.com/?api-key=REPLACE_ME

# Solana JSON-RPC endpoint (WebSocket, for account/log subscriptions)
RPC_WSS_URL=wss://your-rpc-provider.example.com/?api-key=REPLACE_ME

# Helius API key, used for enhanced transaction parsing and token metadata
HELIUS_API_KEY=REPLACE_ME

# Jupiter Swap API key. Optional: without it the free lite host is used,
# which rate-limits harder and rejects restrictIntermediateTokens=false.
JUPITER_API_KEY=REPLACE_ME
