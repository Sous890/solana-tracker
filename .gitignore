# secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
keypair*.json
wallet*.json
# …except recorded transaction fixtures, whose FILENAMES collide with the rule
# above while their contents are public chain data. `wallet-key-from-lookup-table`
# describes what the capture exercises — a wallet key resolved from an address
# lookup table — not what it contains: a mainnet signature, account keys and
# instruction data, no key material. The suite fails 7 swapParser tests without
# it, and because the file was ignored it was never committed and `git status`
# stayed clean, so the gap was invisible. Scoped to this one directory, so a
# real keypair dropped anywhere else in the tree is still ignored.
!tests/fixtures/transactions/wallet*.json

# local config (may contain operator-specific paths)
config.json

# build output
dist/
*.tsbuildinfo

# dependencies
node_modules/

# data
# pool signature cache — regenerable, and large
cache/

# wallet history exports — regenerable, and large
exports/
data/
# recorded replay sessions — real market data, and they get large. The
# committed example lives at tests/replay/fixtures/synthetic-mirror.jsonl.
sessions/
*.db
*.db-journal
*.db-wal
*.db-shm

