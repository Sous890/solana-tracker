{
  "name": "solana-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Solana wallet/token tracker and paper-trading bot",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "orphans": "tsx src/cli/orphans.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "tsx src/cli/serve.ts",
    "replay": "tsx tests/replay/run.ts",
    "soak": "tsx src/cli/soak.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.5",
